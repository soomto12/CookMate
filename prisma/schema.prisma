// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes       Recipe[]
  shoppingLists ShoppingList[]
  allergen      Allergen?
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// An AI-generated recipe: what it's called, plus everything needed to cook it.
model Recipe {
  id              String      @id @default(cuid())
  title           String
  description     String?
  cuisine         String?
  servings        Int?
  cookTimeMinutes Int?
  difficulty      Difficulty?
  imageUrl        String?
  imageCredit     String?
  imageCreditUrl  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  ingredients   RecipeIngredient[]
  steps         RecipeStep[]
  shoppingLists ShoppingList[]
}

// One ingredient this recipe needs, e.g. "2 cups rice". Not linked to a shared
// catalog - just free text, compared by name against what the user said they have.
model RecipeIngredient {
  id       String  @id @default(cuid())
  name     String
  quantity Float?
  unit     String?

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, name])
}

// One numbered instruction in the recipe's method.
model RecipeStep {
  id          String @id @default(cuid())
  order       Int
  instruction String

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, order])
}

// The ingredients missing for a specific recipe the user chose to cook,
// generated by the AI when it notices the recipe needs something the user
// didn't say they have. 
model ShoppingList {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  items ShoppingListItem[]
}

model ShoppingListItem {
  id        String   @id @default(cuid())
  name      String
  quantity  Float?
  unit      String?
  purchased Boolean  @default(false)
  createdAt DateTime @default(now())

  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
}

// A user's allergy list: one per user, holding the array of foods they're
// allergic to.
model Allergen {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  foods Food[]
}

// A food item, e.g. "peanut". Shared across users - one row per name, so many
// users' allergen lists can point at the same food.
model Food {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allergens Allergen[]
}